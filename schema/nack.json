{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysmatt.github.io/catnector-protocol/schema/nack.json",
  "title": "Catnector Protocol \u2014 nack",
  "allOf": [
    {
      "$ref": "common.json#/$defs/envelopeFields"
    }
  ],
  "type": "object",
  "properties": {
    "v": {
      "$ref": "common.json#/$defs/version"
    },
    "type": {
      "const": "nack"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "re": {
      "$ref": "common.json#/$defs/id"
    },
    "req": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ts": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "reason": {
      "type": "string",
      "enum": [
        "unsupported_req",
        "unknown_mode",
        "out_of_range",
        "rig_offline",
        "manual_mode",
        "ptt_timeout",
        "rejected"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "re",
    "reason"
  ],
  "additionalProperties": true
}
